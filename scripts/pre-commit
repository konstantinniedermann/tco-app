#!/usr/bin/env bash
# Lokaler pre-commit-Hook (Installation: make hooks).
# Feature-Branches laufen nicht durch den CI-Secret-Scan (nur dev/main), daher hier.
set -euo pipefail

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner --redact --exit-code 1
else
  echo "Warnung: gitleaks nicht installiert — Secret-Scan übersprungen (brew install gitleaks)."
fi

bash scripts/check-docs.sh
