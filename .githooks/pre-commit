#!/usr/bin/env bash
# Lokaler pre-commit-Hook (aktivieren: make hooks).
# Feature-Branches laufen erst beim PR durch den CI-Secret-Scan, daher schon hier.
# Reine Doku-Commits: Secret-Scan + Doku-Check. Sobald Code dabei ist: make check-schnell.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Abbruch: gitleaks fehlt — ohne Secret-Scan kein Commit (brew install gitleaks)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --no-banner --redact --exit-code 1

# Exit 0 = nur Doku; jeder andere Exit (Code oder Fehler) zählt als Code.
if git diff --cached --name-only --no-renames | node scripts/pruefungen/nur-doku.ts; then
  bash scripts/check-docs.sh
else
  make check-schnell
fi
