# Nur lokal (Entwicklung). Kein echtes Passwort, keine Produktivdaten.
DATABASE_URL=postgres://mytco:mytco_lokal@localhost:55432/mytco

# Login per Einmal-Code (#29). Der Schlüssel ist nur lokal gültig; erzeugen mit
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MYTCO_CODE_SCHLUESSEL=nur-lokal-nicht-fuer-produktion-0123456789abcdef
# IP statt «localhost»: Mailpit lauscht nur auf 127.0.0.1 (docker-compose.yml)
MYTCO_SMTP_URL=smtp://127.0.0.1:51025
MYTCO_MAIL_ABSENDER=MyTCO <mytco@example.org>
MYTCO_KONTAKT=das Sekretariat (erfunden), sekretariat@example.org
MYTCO_ADRESSE=http://localhost:5173

# Push-Mitteilungen (#63, SI-22). Das Paar ist nur lokal gültig; erzeugen mit
# npx web-push generate-vapid-keys
# (Zeilenende «gitleaks:allow»: öffentlich im Repo, gilt nur lokal.)
MYTCO_VAPID_OEFFENTLICH=BCUfPbrWschrERMITs9b_aJhHWZSvc7oWyUHpVd_omS5ejcBc5z7q2beiy7XknqCc5dnOM7olJiRPqYTc66ltm4 # gitleaks:allow
MYTCO_VAPID_PRIVAT=AlluMnyXOTzUIJlj8DqJ8fyieKtuVOMsa0u-fKAuKxI # gitleaks:allow

# Interclub (#81): Vereinsnummer bei Swiss Tennis, nur für make ic-import (Vorgabe 2202).
# IC_VEREIN=2202

# Täglicher Löschlauf (#43): läuft standardmässig; «aus» schaltet ihn ab (nur lokal und E2E;
# auf Test und Live reicht betrieb/compose.umgebung.yml die Variable nicht durch).
# ZEITGEBER=aus
