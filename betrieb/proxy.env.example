# Einstellungen des Webservers: als proxy/proxy.env auf dem Server anlegen.

# Annahme K-10: Live läuft unter my.tcolten.ch, Test unter test.my.tcolten.ch.
MYTCO_ADRESSE_LIVE=
MYTCO_ADRESSE_TEST=

# Leer lassen für öffentliche Zertifikate; "internal" nur für den lokalen Nachweis.
MYTCO_TLS=

# Zugang zur Testumgebung. Hash erzeugen mit: caddy hash-password
# Den Hash in einfache Anführungszeichen setzen, sonst frisst Compose die $-Zeichen:
# MYTCO_TEST_PASSWORT_HASH='$2a$14$...'
MYTCO_TEST_BENUTZER=
MYTCO_TEST_PASSWORT_HASH=
