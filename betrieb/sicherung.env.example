# Sicherung mit restic: als sicherung.env auf dem Server anlegen (Rechte 600).
# Ziel: Vorschlag in docs/betrieb-und-uebergabe.md, festgelegt mit dem Hosting; bis dahin leer.

RESTIC_REPOSITORY=
# Zufallswert, z. B. mit: openssl rand -hex 32. Ohne ihn ist die Sicherung nicht lesbar: separat aufbewahren.
RESTIC_PASSWORD=

# Zugang zum S3-kompatiblen Speicher
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
