#!/usr/bin/env bash
# ausliefern <umgebung> <digest>: übernimmt die Einrichtung aus dem Image, sichert Live,
# migriert, startet die neue App und fällt bei Fehlern auf das vorherige Image zurück.
# Läuft aus fassungen/<digest>/betrieb/bin/. Ausgabe nur "schritt: …", "ok" oder "fehler";
# alles von docker steht im Protokoll der Umgebung.
set -euo pipefail
# Bricht die SSH-Verbindung ab, läuft die Auslieferung zu Ende (Ausgaben gehen dann ins Leere).
trap '' PIPE HUP

# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

UMGEBUNG="${1-}"
DIGEST="${2-}"
MYTCO_REPO="${MYTCO_REPO:-$MYTCO_REPO_STANDARD}"
MYTCO_WARTEZEIT="${MYTCO_WARTEZEIT:-60}"

pruefe_umgebung "$UMGEBUNG" || exit 1
pruefe_digest "$DIGEST" || exit 1

U="$MYTCO_BASIS/$UMGEBUNG"
FASSUNG="$MYTCO_BASIS/fassungen/$DIGEST/betrieb"
PROXY="$MYTCO_BASIS/proxy"
GEMEINSAM="$MYTCO_BASIS/gemeinsam/bin"
LOG="$U/protokoll.log"
SICHERUNG=""
BETRIEB_NEU=0
LAUFEND=""
GESPERRT=0
GEMELDET=0
ALT_DIGEST=""

ende() {
	local rc=$?
	# Abbruch (Signal, set -e) mitten in der Übernahme: alles zurück wie bei einem Fehler.
	if [ -n "$SICHERUNG" ]; then
		set +e
		alles_zuruecksetzen
		proxy_neu_laden
	fi
	if [ "$GESPERRT" = 1 ]; then sperre_freigeben "$UMGEBUNG"; fi
	# Jeder unerwartete Abbruch (set -e) endet mit genau einem "fehler".
	if [ "$GEMELDET" = 0 ] && [ "$rc" != 0 ]; then
		melde fehler
	fi
	if [ "$rc" != 0 ]; then exit 1; fi
	exit 0
}
trap ende EXIT

scheitern() {
	echo "ausliefern: $1" >>"$LOG"
	GEMELDET=1
	melde fehler
	exit 1
}

# Fällt auf das bisher laufende Image zurück (nur wenn es eines gab); endet immer mit "fehler".
rueckfall() {
	if [ -n "$ALT_DIGEST" ]; then
		schritt "rueckfall"
		MYTCO_IMAGE="$MYTCO_REPO@$ALT_DIGEST" protokoll "$UMGEBUNG" \
			compose "$UMGEBUNG" up -d --wait --wait-timeout "$MYTCO_WARTEZEIT" app &&
			echo "ausliefern: Rückfall auf $ALT_DIGEST läuft gesund" >>"$LOG" ||
			echo "ausliefern: Rückfall auf $ALT_DIGEST ebenfalls nicht gesund" >>"$LOG"
	fi
	scheitern "App nicht gesund"
}

# Datei atomar mit Inhalt ersetzen.
schreibe_zustand() {
	printf '%s\n' "$2" >"$1.neu.$$"
	mv "$1.neu.$$" "$1"
}

schritt "pruefen"
if ! sperre_nehmen "$UMGEBUNG"; then
	GEMELDET=1
	melde fehler
	exit 1
fi
GESPERRT=1
mkdir -p "$U/zustand"
# Eigene Fehlermeldungen der Werkzeuge nie an den Aufrufer, nur ins Protokoll.
exec 2>>"$LOG"
if [ -s "$U/zustand/aktuell" ]; then
	ALT_DIGEST=$(head -n 1 "$U/zustand/aktuell")
fi
[ -d "$FASSUNG" ] || scheitern "Fassung fehlt: $FASSUNG"
export MYTCO_IMAGE="$MYTCO_REPO@$DIGEST"

# --- Live sichern, bevor irgendetwas geändert wird -----------------------------------------
# Mit der bisherigen Einrichtung und dem bisherigen Sicherungsskript; ohne laufende
# Datenbank (erster Lauf) gibt es nichts zu sichern.
if [ "$UMGEBUNG" = live ] && [ -f "$U/betrieb/compose.umgebung.yml" ]; then
	DB_LAEUFT=$(compose live ps --status running -q db 2>>"$LOG") ||
		scheitern "Zustand der Datenbank unbekannt"
	if [ -n "$DB_LAEUFT" ]; then
		schritt "sichern"
		[ -x "$GEMEINSAM/sichern" ] || scheitern "gemeinsam/bin/sichern fehlt"
		protokoll live "$GEMEINSAM/sichern" live || scheitern "Sicherung gescheitert"
	fi
fi

# --- Einrichtung übernehmen ---------------------------------------------------------------
schritt "einrichtung uebernehmen"
GEMEINSAME_TEILE=0
if [ "$UMGEBUNG" = live ] || [ ! -e "$MYTCO_BASIS/live/zustand/aktuell" ]; then
	GEMEINSAME_TEILE=1
fi

# merke <pfad relativ zu MYTCO_BASIS>: Zustand vor der Übernahme festhalten.
merke() {
	echo "$1" >>"$SICHERUNG/liste"
	if [ -f "$MYTCO_BASIS/$1" ]; then
		mkdir -p "$SICHERUNG/dateien/$(dirname "$1")"
		cp -p "$MYTCO_BASIS/$1" "$SICHERUNG/dateien/$1"
	fi
}

# uebernimm <quelle> <pfad relativ zu MYTCO_BASIS>
uebernimm() {
	merke "$2"
	mkdir -p "$(dirname "$MYTCO_BASIS/$2")"
	cp -p "$1" "$MYTCO_BASIS/$2"
}

# Stellt alles zurück, was dieser Schritt übernommen hat: gemerkte Dateien an Ort und Stelle,
# neu hinzugekommene entfernt, die Einrichtung der Umgebung aus der Sicherung. Läuft auch nach
# einem Abbruch an beliebiger Stelle der Übernahme (aus ende).
alles_zuruecksetzen() {
	local rel
	if [ -f "$SICHERUNG/liste" ]; then
		while IFS= read -r rel; do
			if [ -f "$SICHERUNG/dateien/$rel" ]; then
				cp -p "$SICHERUNG/dateien/$rel" "$MYTCO_BASIS/$rel"
			else
				rm -f "$MYTCO_BASIS/$rel"
			fi
		done <"$SICHERUNG/liste"
	fi
	if [ -d "$SICHERUNG/betrieb-alt" ]; then
		rm -rf "$U/betrieb"
		mv "$SICHERUNG/betrieb-alt" "$U/betrieb"
	elif [ "$BETRIEB_NEU" = 1 ]; then
		rm -rf "$U/betrieb"
	fi
	rm -rf "$U/betrieb.neu"
	# Erledigt: ende darf nicht ein zweites Mal zurücksetzen.
	rm -rf "$SICHERUNG"
	SICHERUNG=""
}

# Lädt die (zurückgesetzte) Konfiguration in den laufenden Proxy; nur ins Protokoll.
proxy_neu_laden() {
	if [ -n "$LAUFEND" ]; then
		protokoll "$UMGEBUNG" compose_proxy exec -T caddy caddy reload \
			--config /etc/caddy/Caddyfile --adapter caddyfile || true
	fi
}

# Sicherung dessen, was dieser Schritt überschreibt. Dateien werden an Ort und Stelle
# überschrieben und zurückgeschrieben (gleicher Inode), weil der laufende Proxy sie per
# Bind-Mount sieht; Ordner werden nie gelöscht und neu angelegt.
SICHERUNG="$PROXY/.sicherung.$$"
rm -rf "$SICHERUNG"
mkdir -p "$SICHERUNG/dateien"
: >"$SICHERUNG/liste"

# Der Proxy-Container liest die Caddy-Dateien über Bind-Mounts. Trotz umask 077 (lib.sh) für
# alle lesbar; Geheimnisse stehen darin keine (die liegen in proxy.env).
mkdir -p "$PROXY/caddy/umgebungen"
chmod 755 "$PROXY/caddy" "$PROXY/caddy/umgebungen"

# Einrichtung der Umgebung: ersetzen, nicht mischen (alte bleibt in der Sicherung).
rm -rf "$U/betrieb.neu"
cp -R "$FASSUNG" "$U/betrieb.neu"
if [ -d "$U/betrieb" ]; then mv "$U/betrieb" "$SICHERUNG/betrieb-alt"; fi
mv "$U/betrieb.neu" "$U/betrieb"
BETRIEB_NEU=1
uebernimm "$FASSUNG/caddy/umgebungen/$UMGEBUNG.caddy" "proxy/caddy/umgebungen/$UMGEBUNG.caddy"
chmod 644 "$PROXY/caddy/umgebungen/$UMGEBUNG.caddy"

if [ "$GEMEINSAME_TEILE" = 1 ]; then
	uebernimm "$FASSUNG/caddy/Caddyfile" "proxy/caddy/Caddyfile"
	chmod 644 "$PROXY/caddy/Caddyfile"
	uebernimm "$FASSUNG/compose.proxy.yml" "proxy/compose.proxy.yml"
	for datei in sichern wiederherstellen probe lib.sh; do
		if [ -f "$FASSUNG/bin/$datei" ]; then
			uebernimm "$FASSUNG/bin/$datei" "gemeinsam/bin/$datei"
			chmod +x "$GEMEINSAM/$datei"
		fi
	done
fi

# Caddy prüfen (im laufenden Proxy oder in einem Wegwerf-Container), erst dann laden.
LAUFEND=$(compose_proxy ps --status running -q caddy 2>>"$LOG" || true)
GUELTIG=0
if [ -n "$LAUFEND" ]; then
	protokoll "$UMGEBUNG" compose_proxy exec -T caddy caddy validate \
		--config /etc/caddy/Caddyfile --adapter caddyfile && GUELTIG=1
else
	protokoll "$UMGEBUNG" compose_proxy run --rm --no-deps caddy caddy validate \
		--config /etc/caddy/Caddyfile --adapter caddyfile && GUELTIG=1
fi
if [ "$GUELTIG" != 1 ]; then
	alles_zuruecksetzen
	scheitern "Caddy-Konfiguration ungültig, alles zurückgesetzt"
fi
# Neue Konfiguration sofort laden; `up -d` danach erstellt den Container nur neu, wenn sich
# compose.proxy.yml (z. B. der Caddy-Digest) oder proxy.env geändert hat, und startet ihn, wenn
# er nicht läuft.
if [ -n "$LAUFEND" ]; then
	protokoll "$UMGEBUNG" compose_proxy exec -T caddy caddy reload \
		--config /etc/caddy/Caddyfile --adapter caddyfile || {
		alles_zuruecksetzen
		scheitern "Caddy konnte nicht neu geladen werden, alles zurückgesetzt"
	}
fi
protokoll "$UMGEBUNG" compose_proxy up -d || {
	alles_zuruecksetzen
	protokoll "$UMGEBUNG" compose_proxy up -d || true
	proxy_neu_laden
	scheitern "Proxy konnte nicht gestartet werden, alles zurückgesetzt"
}
rm -rf "$SICHERUNG"
SICHERUNG=""

# --- Test zurücksetzen --------------------------------------------------------------------
if [ "$UMGEBUNG" = test ]; then
	schritt "test zuruecksetzen"
	protokoll test compose test down --volumes || scheitern "down gescheitert"
fi

# --- Datenbank und Migration --------------------------------------------------------------
schritt "migrieren"
protokoll "$UMGEBUNG" compose "$UMGEBUNG" up -d --wait db || scheitern "Datenbank startet nicht"
protokoll "$UMGEBUNG" compose "$UMGEBUNG" run --rm --no-deps app node scripts/migrate.ts ||
	scheitern "Migration gescheitert"

# --- Testdaten (nur Test, nur wenn das Image sie enthält) ---------------------------------
if [ "$UMGEBUNG" = test ] &&
	protokoll test compose test run --rm --no-deps app test -f scripts/testdaten.ts; then
	schritt "testdaten laden"
	protokoll test compose test run --rm --no-deps app node scripts/testdaten.ts ||
		scheitern "Testdaten gescheitert"
fi

# --- App starten --------------------------------------------------------------------------
schritt "app starten"
protokoll "$UMGEBUNG" compose "$UMGEBUNG" up -d --wait --wait-timeout "$MYTCO_WARTEZEIT" app ||
	rueckfall

# --- Zustand festhalten, aufräumen --------------------------------------------------------
schritt "abschliessen"
if [ -n "$ALT_DIGEST" ] && [ "$ALT_DIGEST" != "$DIGEST" ]; then
	schreibe_zustand "$U/zustand/vorher" "$ALT_DIGEST"
fi
schreibe_zustand "$U/zustand/aktuell" "$DIGEST"

# Images des Repos löschen, ausser aktuell/vorher beider Umgebungen. Fehler nur ins Protokoll.
BEHALTEN=""
for datei in test/zustand/aktuell test/zustand/vorher live/zustand/aktuell live/zustand/vorher; do
	if [ -s "$MYTCO_BASIS/$datei" ]; then
		BEHALTEN="$BEHALTEN $(head -n 1 "$MYTCO_BASIS/$datei")"
	fi
done
VORHANDEN=$(docker image ls --digests --format '{{.Digest}}' "$MYTCO_REPO" 2>>"$LOG" || true)
for kandidat in $VORHANDEN; do
	case "$kandidat" in
	sha256:*) ;;
	*) continue ;;
	esac
	case " $BEHALTEN " in
	*" $kandidat "*) continue ;;
	esac
	protokoll "$UMGEBUNG" docker image rm "$MYTCO_REPO@$kandidat" || true
done

GEMELDET=1
melde ok
