#!/usr/bin/env bash
# wiederherstellen <umgebung> [lauf] [ohne-sicherung]: spielt eine Sicherung derselben Umgebung
# ein. Ohne Lauf der neueste. Snapshots anderer Umgebungen werden nie angefasst (DS-08).
# Vor dem Einspielen sichert es den jetzigen Stand (ohne Aufräumen); scheitert das, ändert es
# nichts. Der Notschalter ohne-sicherung (für eine kaputte Datenbank, nur von Hand auf dem
# Server) lässt diese Sicherung weg; das Protokoll hält es fest.
# Die App ist während des Einspielens gestoppt und läuft danach wieder, auch bei Fehlern.
# Die Schemas der App (public, drizzle mit der Migrationstabelle) werden vorher geleert, damit
# keine Tabelle einer späteren Migration stehen bleibt. Alles in einer Transaktion: Nur ein
# vollständiger Dump wird bestätigt, sonst bleibt der alte Stand. psql meldet Fehler nur mit
# ihrem SQLSTATE: Hauptzeile, DETAIL und CONTEXT tragen sonst Werte ins Protokoll (DS-06).
set -euo pipefail

# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

UMGEBUNG="${1-}"
pruefe_umgebung "$UMGEBUNG" || exit 1
shift

# Danach höchstens ein Lauf und der Notschalter, in beliebiger Reihenfolge. Alles andere wird
# abgewiesen, bevor etwas geschieht.
LAUF_WUNSCH=""
OHNE_SICHERUNG=0
[ "$#" -le 2 ] || {
	melde fehler
	exit 1
}
for angabe in "$@"; do
	if [ "$angabe" = ohne-sicherung ] && [ "$OHNE_SICHERUNG" = 0 ]; then
		OHNE_SICHERUNG=1
	elif [ -z "$LAUF_WUNSCH" ] && ist_lauf_name "$angabe"; then
		LAUF_WUNSCH="$angabe"
	else
		melde fehler
		exit 1
	fi
done

LOG="$MYTCO_BASIS/$UMGEBUNG/protokoll.log"
GEMELDET=0
GESPERRT=0
GESTOPPT=0

ende() {
	local rc=$?
	if [ "$GESTOPPT" = 1 ]; then compose "$UMGEBUNG" start app >>"$LOG" 2>&1 || true; fi
	if [ "$GESPERRT" = 1 ]; then sperre_freigeben "$UMGEBUNG"; fi
	if [ "$GEMELDET" = 0 ] && [ "$rc" != 0 ]; then
		melde fehler
	fi
	if [ "$rc" != 0 ]; then exit 1; fi
	exit 0
}
trap ende EXIT

scheitern() {
	echo "wiederherstellen: $1" >>"$LOG"
	GEMELDET=1
	melde fehler
	exit 1
}

mkdir -p "$MYTCO_BASIS/$UMGEBUNG"
exec 2>>"$LOG"
[ -f "$MYTCO_BASIS/sicherung.env" ] || scheitern "sicherung.env fehlt"
sicherungsziel >/dev/null || scheitern "Sicherungsziel ungültig"

# Der Lauf wird vor der Sicherung bestimmt, sonst wäre ohne Lauf-Angabe der eben gesicherte
# Stand der neueste.
schritt "snapshot suchen"
LAUF=$(finde_lauf "$UMGEBUNG" "$LAUF_WUNSCH") || scheitern "kein Snapshot dieser Umgebung gefunden"

# Compose verlangt MYTCO_IMAGE bei jedem Befehl, der den Dienst app betrifft: das laufende Image.
AKTUELL="$MYTCO_BASIS/$UMGEBUNG/zustand/aktuell"
[ -s "$AKTUELL" ] || scheitern "keine ausgelieferte Fassung (zustand/aktuell fehlt)"
image_aus_zustand "$UMGEBUNG"

# Keine Auslieferung gleichzeitig.
sperre_nehmen "$UMGEBUNG" || scheitern "Umgebung ist gesperrt"
GESPERRT=1

# Ohne Aufräumen: Ein knapp 30 Tage alter, gerade gewählter Lauf bleibt bis zum Einspielen da.
if [ "$OHNE_SICHERUNG" = 1 ]; then
	echo "wiederherstellen: ohne Sicherung vorher (Notschalter)" >>"$LOG"
else
	schritt "sichern"
	"$(dirname "${BASH_SOURCE[0]}")/sichern" "$UMGEBUNG" ohne-aufraeumen </dev/null >>"$LOG" ||
		scheitern "Sicherung vor dem Einspielen gescheitert"
fi

schritt "app stoppen"
GESTOPPT=1
compose "$UMGEBUNG" stop app >>"$LOG" || scheitern "App nicht zu stoppen"

# SQL für psql: Schemas leeren, Dump als SQL (pg_restore -f -), COMMIT nur bei Erfolg.
# Endet die Eingabe ohne COMMIT, verwirft PostgreSQL die offene Transaktion. Der Dump fliesst
# nur durch Pipes, nie als Datei auf die Platte.
sql_zum_einspielen() {
	printf '%s\n' 'BEGIN;' \
		'DROP SCHEMA IF EXISTS public CASCADE;' \
		'DROP SCHEMA IF EXISTS drizzle CASCADE;' \
		'CREATE SCHEMA public;'
	restic_docker dump --tag "$UMGEBUNG,$LAUF" --path "/mytco-$UMGEBUNG.dump" latest \
		"/mytco-$UMGEBUNG.dump" </dev/null |
		compose "$UMGEBUNG" exec -T db pg_restore -f - || return 1
	printf '%s\n' 'COMMIT;'
}

schritt "einspielen"
sql_zum_einspielen |
	compose "$UMGEBUNG" exec -T db psql -X -q -v ON_ERROR_STOP=1 -v VERBOSITY=sqlstate -U mytco -d mytco >>"$LOG" ||
	scheitern "Einspielen gescheitert"

schritt "app starten"
GESTOPPT=0
compose "$UMGEBUNG" start app >>"$LOG" || scheitern "App startet nicht"

echo "wiederherstellen: $LAUF eingespielt" >>"$LOG"
melde ok
