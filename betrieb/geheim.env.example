# Geheimnisse einer Umgebung: als <umgebung>/geheim.env auf dem Server anlegen (Rechte 600).
# Nie ins Repo; hier stehen nur leere Vorlagen.

# Zufallswert, z. B. mit: openssl rand -hex 32
POSTGRES_PASSWORD=

# Öffentliche Adresse dieser Umgebung mit https://, ohne Schrägstrich am Ende
ORIGIN=

# Nur Test: alle Mails gehen an diese eine Adresse (hängt an K-11). Auf Live leer lassen.
MAIL_NUR_AN=
