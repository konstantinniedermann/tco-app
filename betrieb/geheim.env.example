# Geheimnisse einer Umgebung: als <umgebung>/geheim.env auf dem Server anlegen (Rechte 600).
# Nie ins Repo; hier stehen nur leere Vorlagen.

# Zufallswert, z. B. mit: openssl rand -hex 32
POSTGRES_PASSWORD=

# Öffentliche Adresse dieser Umgebung mit https://, ohne Schrägstrich am Ende
ORIGIN=

# Nur Test: alle Mails werden an diese Adresse umgeleitet, der Betreff nennt den ursprünglichen
# Empfänger als «[Test für <Adresse>] » (hängt an K-11). Auf Live leer lassen.
MAIL_NUR_AN=

# Schlüssel für die Login-Codes, mindestens 32 Zeichen, je ein eigener für Test und Live.
# Erzeugen mit: openssl rand -base64 48 | tr -d '\n/+='
MYTCO_CODE_SCHLUESSEL=

# Zugang zum Mail-Versand als SMTP-URL, nur mit TLS: smtps://… oder smtp://…?requireTLS=true
# Annahme K-11: Der Anbieter ist offen und wird nur über diese Einstellung gewechselt
MYTCO_SMTP_URL=

# Absender der Code-Mails, z. B. MyTCO <mytco@…>
MYTCO_MAIL_ABSENDER=

# Ansprechperson bei Login-Problemen, freier Text
# Annahme K-21: Ansprechperson für Login-Probleme als freier Text in der Einstellung
MYTCO_KONTAKT=

# App-Adresse für Brief und QR-Code mit https://; leer = Standard der App
# Annahme K-10: App-Adresse my.tcolten.ch, wenn MYTCO_ADRESSE fehlt
MYTCO_ADRESSE=
